# Copy these into Vercel → Project → Settings → Environment Variables.

# Supabase (Project Settings → API). The service role key is secret: never put it in client code.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys)
RESEND_API_KEY=
# After verifying urbansmile.in in Resend, set a sender on your domain. Until then leave this unset
# (emails then come from onboarding@resend.dev and can only go to the email you signed up to Resend with).
RESEND_FROM=Urban Smile <appointments@urbansmile.in>
# Where booking notifications go
CLINIC_EMAIL=urbansmilepune@gmail.com

# Cloudinary cloud name (optional, for photos)
PUBLIC_CLOUDINARY_CLOUD_NAME=
