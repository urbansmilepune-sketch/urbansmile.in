---
import Base from '../layouts/Base.astro';
import { SITE, waLink } from '../data/site';
---
<Base title="Thank You" description="Your request has been received." noindex>
  <section class="section"><div class="wrap center">
    <h1>Thank you!</h1>
    <p class="section-intro">We've received your request and will call you within 2 hours during clinic hours ({SITE.hours.label}).</p>
    <div class="btn-row" style="justify-content:center"><a class="btn btn-wa" href={waLink()} rel="noopener">WhatsApp Us</a><a class="btn btn-outline" href="/">Back to home</a></div>
  </div></section>
</Base>
