---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import { SITE, waLink } from '../data/site';
---
<Base
  title="Contact Urban Smile Dental Clinic | Wakad, Pune"
  description={`Contact Urban Smile Dental Clinic, Wakad, Pune. Call ${SITE.phone}, WhatsApp or email. Open ${SITE.hours.label}. Above Starbucks, near Bhumkar Chowk.`}
  crumbs={[{ name: 'Contact', url: '/contact' }]}
>
  <section class="hero">
    <div class="wrap">
      <h1>Contact Us</h1>
      <p class="lead">Questions about implants or want to book? Call, WhatsApp or send us a message.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/book">Book Appointment Online</a><a class="btn btn-wa" href={waLink('Hi, I would like to know more about your dental services.')} rel="noopener">WhatsApp Us</a></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap two-col">
      <div>
        <h2>Send Us a Message</h2>
        <p class="section-intro">We reply within 2 hours during clinic hours.</p>
        <BookingForm type="contact" />
      </div>
      <div>
        <div class="card" style="margin-bottom:20px">
          <h3>Urban Smile Dental Clinic</h3>
          <p>{SITE.address.full}</p>
          <p><strong>Phone:</strong> <a href={SITE.phoneHref}>{SITE.phone}</a><br />
          <strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <strong>Hours:</strong> {SITE.hours.label}<br />
          <strong>Parking:</strong> Free</p>
          <a href={SITE.mapsUrl} rel="noopener">Open in Google Maps →</a>
        </div>
        <iframe class="map" src={SITE.mapsEmbed} title="Urban Smile Dental Clinic on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
